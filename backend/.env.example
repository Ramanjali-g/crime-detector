# Copy to .env (never commit .env). Loaded automatically when you run from /backend.
MONGODB_URI=mongodb://localhost:27017/crime_detector
# REQUIRED: at least 32 characters. Generate one, see root README.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
# Optional: set a password to create demo@example.com with labelled sample data
SEED_DEMO_PASSWORD=
